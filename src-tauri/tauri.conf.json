{
    "productName": "AccountingFlow",
    "version": "0.1.0",
    "identifier": "com.accountingflow.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "AccountingFlow",
                "width": 1200,
                "height": 800,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico",
            "icons/icon.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/32x32.png",
            "icons/64x64.png"
        ],
        "publisher": "AccountingFlow"
    }
}