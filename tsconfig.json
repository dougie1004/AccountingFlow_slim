{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "Node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@bridge/*": [
                "src/bridge/*"
            ],
            "@core/*": [
                "src/core_engine/*"
            ],
            "@strategic/*": [
                "src/strategic_layer/*"
            ],
            "@constitution/*": [
                "src/constitution/*"
            ],
            "@types": [
                "src/types/index"
            ],
            "@types/*": [
                "src/types/*"
            ],
            "@const/*": [
                "src/constants/*"
            ],
            "@hooks/*": [
                "src/hooks/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@components/*": [
                "src/components/*"
            ]
        }
    },
    "include": [
        "src"
    ],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}